# Copy to .env.local for local development.
# On Vercel, set them in Project Settings → Environment Variables (Production and Preview).

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://project-name.vercel.app

# --- Server keys (never exposed to the browser) ---
# SERVICE_API_KEY=your_server_key

# --- Browser keys (public, must be restricted by HTTP referrer) ---
# NEXT_PUBLIC_SERVICE_KEY=your_browser_key
